# For Docker Compose, copy to .env and set a randomly generated token.
# Example generator: openssl rand -hex 32
SAI_DH_TOKEN=
SAI_DH_AUTH_MODE=token
SAI_DH_PORT=8083

# Alternative: sai-auth authorizes method/path without seeing request bodies.
# SAI_DH_AUTH_MODE=sai-auth
# SAI_DH_AUTH_URL=https://auth.example.com
# SAI_DH_AUTH_TIMEOUT=3s
# SAI_DH_AUTH_ALLOW_HTTP=false

# Local binary reads environment variables, not .env automatically.
# Instead of an environment token, mount a file and set SAI_DH_TOKEN_FILE.
