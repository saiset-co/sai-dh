  "components": {
    "securitySchemes": {
      "BearerToken": {
        "type": "http",
        "scheme": "bearer"
      },
      "SaiToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Token"
      }
    },
    "schemas": {
      "EmptyRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "KeyPairResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "suite": {
            "type": "string"
          },
          "private_key": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "public_key": {
            "type": "string",
            "minLength": 130,
            "maxLength": 130,
            "pattern": "^04[0-9a-fA-F]{128}$"
          },
          "fingerprint": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "required": [
          "suite",
          "private_key",
          "public_key",
          "fingerprint"
        ]
      },
      "SaltResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "salt": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "required": [
          "salt"
        ]
      },
      "DeriveRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "private_key": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "public_key": {
            "type": "string",
            "minLength": 130,
            "maxLength": 130,
            "pattern": "^04[0-9a-fA-F]{128}$"
          },
          "salt": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Exact context bytes; maximum 1024 UTF-8 bytes. Use distinct agreed contexts per direction/purpose."
          }
        },
        "required": [
          "private_key",
          "public_key",
          "salt",
          "context"
        ]
      },
      "DeriveResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "suite": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "required": [
          "suite",
          "key"
        ]
      },
      "EncryptRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "message": {
            "type": "string",
            "default": "",
            "maxLength": 1048576,
            "description": "Maximum 1048576 UTF-8 bytes; the encoded HTTP request must also fit 4 MiB."
          },
          "aad": {
            "type": "string",
            "default": "",
            "maxLength": 4096,
            "description": "Maximum 4096 UTF-8 bytes."
          }
        },
        "required": [
          "key"
        ]
      },
      "Envelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "AES-256-GCM"
            ]
          },
          "ciphertext": {
            "type": "string",
            "minLength": 56,
            "maxLength": 2097208,
            "pattern": "^[0-9a-fA-F]+$",
            "description": "Hex(nonce[12] || ciphertext || GCM tag[16]); even hex length required."
          }
        },
        "required": [
          "version",
          "algorithm",
          "ciphertext"
        ]
      },
      "DecryptRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "envelope": {
            "$ref": "#/components/schemas/Envelope"
          },
          "aad": {
            "type": "string",
            "default": "",
            "maxLength": 4096
          }
        },
        "required": [
          "key",
          "envelope"
        ]
      },
      "DecryptResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "plaintext": {
            "type": "string"
          }
        },
        "required": [
          "plaintext"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "CapabilitiesResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "service": {
            "type": "string"
          },
          "suite": {
            "type": "string"
          },
          "stateless": {
            "type": "boolean"
          },
          "max_message_bytes": {
            "type": "integer"
          },
          "peer_authentication": {
            "type": "boolean"
          },
          "replay_protection": {
            "type": "boolean"
          },
          "one_time_pad": {
            "type": "boolean"
          }
        },
        "required": [
          "service",
          "suite",
          "stateless",
          "max_message_bytes",
          "peer_authentication",
          "replay_protection",
          "one_time_pad"
        ]
      }
    }
  }
}
