{
  "openapi": "3.0.3",
  "info": {
    "title": "sai-dh",
    "version": "0.1.0",
    "description": "Trusted stateless crypto endpoint. HTTP callers submit secrets to this server. For messenger E2EE execute pkg/dh on the device. This is not an authenticated handshake, ratchet, replay manager or OTP implementation."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8083",
      "description": "Local development; use HTTPS between hosts"
    }
  ],
  "security": [
    {
      "BearerToken": []
    },
    {
      "SaiToken": []
    }
  ],
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "summary": "Supported crypto primitives and limitations",
        "operationId": "api_v1_capabilities",
        "responses": {
          "200": {
            "description": "Success; secret-bearing responses must not be cached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or failed decryption",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid credentials or denied permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Encoded HTTP request exceeds 4 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "SAI/gateway request rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Operation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Authorization service unavailable; access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
